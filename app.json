{
  "expo": {
    "name": "Révizo",
    "slug": "revizio",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "revizio",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.revizio.app"
    },
    "android": {
      "package": "fr.revizio.app"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
