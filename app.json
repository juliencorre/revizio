{
  "expo": {
    "name": "Révizo",
    "slug": "revizio",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "revizio",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.revizio.app"
    },
    "android": {
      "package": "fr.revizio.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png",
      "lang": "fr",
      "themeColor": "#514CCF",
      "backgroundColor": "#E4E9F2"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Révizo accède aux photos que vous choisissez pour importer un cours.",
          "cameraPermission": "Révizo utilise l’appareil photo pour photographier les pages d’un cours.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/brand/icon.png",
    "description": "Apprendre, réviser et progresser en famille."
  }
}
