{
  "name": "revizio",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "export:web": "expo export --platform web && node scripts/prepare-pwa.mjs",
    "test:e2e": "playwright test",
    "preview:web": "node scripts/serve-web.mjs",
    "server": "tsx server/index.ts",
    "serve": "node dist-server/index.mjs",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist-server/index.mjs",
    "build": "npm run export:web && npm run build:server",
    "test:server": "vitest run tests/server",
    "release:package": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "fastify": "^5.12.8",
    "lucide-react-native": "^1.70.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
