# Serveur familial (Node.js 24). Ces variables ne sont pas intégrées au client.
HOST=127.0.0.1
PORT=4173
REVIZIO_DATA_DIR=.revizio
REVIZIO_STATIC_DIR=dist
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=ministral-3:8b
